

# ---------- Profile ----------
SPRING_PROFILES_ACTIVE=docker

# ---------- Server ----------
SERVER_PORT=8080

# ---------- PostgreSQL ----------
POSTGRES_DB=agriva
POSTGRES_USERNAME=agriva
POSTGRES_PASSWORD=change_me_postgres_strong_password

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_strong_password

# ---------- JWT ----------
# Generate with:  openssl rand -base64 64
# Must decode to at least 64 bytes (512 bits) for HS512.
JWT_SECRET=change_me_to_a_very_long_base64_secret_at_least_512_bits
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# ---------- Logging ----------
LOG_LEVEL=INFO

# ---------- Admin bootstrap ----------
ADMIN_EMAIL=admin@agriva.local
ADMIN_USERNAME=agriva-admin
ADMIN_PASSWORD=change_me_admin_strong_password

# ---------- pgAdmin ----------
PGADMIN_EMAIL=admin@agriva.local
PGADMIN_PASSWORD=change_me_pgadmin_strong_password

# ---------- Grafana ----------
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_grafana_strong_password

FRONTEND_URL=http://localhost:3000